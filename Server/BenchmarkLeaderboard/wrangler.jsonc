{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "storage-cleaner-benchmark-leaderboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-17",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "storage-cleaner-benchmark-leaderboard",
      "database_id": "895cd4d6-6335-4b9b-9619-9029fad76354"
    }
  ],
  "ratelimits": [
    {
      "name": "SUBMISSION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
